# -----------------------------------------------------------------------------
# Django Portfolio Environment Configuration
# -----------------------------------------------------------------------------

# Security
SECRET_KEY=replace-with-a-secure-random-50-character-secret-key
DJANGO_SETTINGS_MODULE=core_project.settings.development
DEBUG=True

# Hostnames (Comma-separated)
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]

# CORS Allowed Origins for React Frontend (Comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173

# Database Configuration
# Local SQLite fallback is used automatically if DATABASE_URL is unset.
# For PostgreSQL (Neon/Render/Local): postgresql://user:password@hostname:5432/dbname?sslmode=require
DATABASE_URL=

# Contact Email Dispatch (Optional in dev, SMTP / Resend / SendGrid in prod)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
NOTIFICATION_RECIPIENT_EMAIL=clickwithmuleta@gmail.com
